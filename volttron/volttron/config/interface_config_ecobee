{
    "building": "3147",
    "manager": "ecobee",
    "module":"app_agents.client",
    "class":"ecobee_init",
    "url": "http://host.docker.internal:5005",
    "topic":"devices/3147/ecobee/all",
    "heartbeat_period": 30,
    "inputs":{"topic":"devices/3147/ecobee/control"},
    "data_point": {
     "ZoneTemperature":
    {"name": "ZoneAirTemperature",
     "label": "Zone air temperature",
     "type": "sensor",
     "unit": "F"},
     "desiredHeat":
    {"name": "ZoneAirHeatingSetpoint",
     "label": "Zone temperature setpoint for heating",
     "type": "control",
     "unit": "F"},
     "desiredCool":
    {"name": "ZoneAirCoolingSetpoint",
     "label": "Zone temperature setpoint for cooling",
     "type": "control",
     "unit": "F"},
     "HVACMode":
    {"name": "HVACMode",
     "label": "HVAC mode",
     "type": "control",
     "unit": "bool"}
    }
}
